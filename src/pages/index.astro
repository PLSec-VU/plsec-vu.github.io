---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import AuthorList from '../components/AuthorList.astro';
import site from '../data/site.json';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const news = (await getCollection('news'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const publications = (await getCollection('publications'))
  .filter((pub) => pub.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const people = (await getCollection('people'))
  .filter((person) => person.data.role !== 'Alumni')
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const assetUrl = (path?: string) => path?.startsWith(base) ? path : path?.startsWith('/') ? withBase(path) : path;
const initials = (name: string) =>
  name
    .replace(/\([^)]*\)/g, '')
    .trim()
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .slice(0, 2);

// The newest news item is also shown next to the introduction.
const latest = news[0];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="hero-place">{site.fullName}</p>
        <h1>{site.heading}</h1>
        {site.intro.map((paragraph) => <p class="lead">{paragraph}</p>)}
        <div class="actions">
          <a class="button" href={withBase('/publications/')}>View publications</a>
          <a class="button secondary" href={withBase('/join/')}>Work with us</a>
        </div>
      </div>
      {latest && (
        <aside class="hero-latest" aria-label="Latest news">
          <NewsCard item={latest} basePath="news" />
        </aside>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Research</h2>
      <div class="areas">
        {site.areas.map((area) => (
          <div class="area">
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>People</h2>
        <a href={withBase('/people/')}>All people</a>
      </div>
      <div class="team-strip">
        {people.map((person) => {
          const personHref = withBase(`/people/${person.id}/`);
          return (
            <article class="team-member">
              <a class="team-photo-link" href={personHref} tabindex="-1" aria-hidden="true">
                {person.data.photo ? (
                  <img src={assetUrl(person.data.photo)} alt="" />
                ) : (
                  <div class="person-initials">{initials(person.data.name)}</div>
                )}
              </a>
              <div>
                <h3><a href={personHref}>{person.data.name}</a></h3>
                <p>{person.data.role}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Selected publications</h2>
        <a href={withBase('/publications/')}>All publications</a>
      </div>
      <div class="pub-list">
        {publications.map((pub) => (
          <article class="publication">
            <h3>{pub.data.title}</h3>
            <div><AuthorList authors={pub.data.authors} /></div>
            <div class="pub-meta">
              <span class="venue">{pub.data.venue} {pub.data.year}</span>
              {pub.data.links.map((link) => <a href={link.url}>{link.label}</a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Posts</h2>
          <a href={withBase('/posts/')}>All posts</a>
        </div>
        <div class="grid">
          {posts.map((post) => <NewsCard item={post} basePath="posts" />)}
        </div>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>News</h2>
          <a href={withBase('/news/')}>All news</a>
        </div>
        <div class="grid">
          {news.map((item) => <NewsCard item={item} basePath="news" />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
