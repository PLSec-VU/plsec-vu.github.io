---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';
---

<BaseLayout title={`Join | ${site.name} at VU Amsterdam`}>
  <PageHeader title="Join us" intro="We welcome strong students interested in programming languages, verification, and security." />
  <section class="section">
    <div class="container grid two">
      {site.join.map((item) => (
        <article class="card">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
    <div class="container actions">
      <a class="button" href={`mailto:${site.joinEmail}`}>Contact us</a>
    </div>
  </section>
</BaseLayout>
